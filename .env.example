# InternS2 (served by LMDeploy/vLLM/SGLang through an OpenAI-compatible API)
INTERNS2_BASE_URL=http://127.0.0.1:23333/v1
INTERNS2_API_KEY=EMPTY
# Leave empty to use the first model returned by GET /v1/models.
INTERNS2_MODEL=
INTERNS2_TIMEOUT=300
INTERNS2_MAX_RETRIES=2
INTERNS2_MAX_TOKENS=2048
INTERNS2_TEMPERATURE=0.2
INTERNS2_TOP_P=0.95
INTERNS2_MAX_TOOL_ROUNDS=3

# DeepSeek or another OpenAI-compatible endpoint used inside NavGPT.
# Replace these three values with the URL, key, and model name of your service.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-your-test-key
DEEPSEEK_MODEL=replace-with-your-model-name
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=1200
DEEPSEEK_TEMPERATURE=0.0

# DeepSeek supports JSON mode. Set this to false only if a compatible proxy does not.
NAVGPT_JSON_MODE=true
