# InternS2 (served by LMDeploy/vLLM/SGLang through an OpenAI-compatible API)
INTERNS2_BASE_URL=http://127.0.0.1:23333/v1
INTERNS2_API_KEY=EMPTY
# Leave empty to use the first model returned by GET /v1/models.
INTERNS2_MODEL=
INTERNS2_TIMEOUT=300
INTERNS2_MAX_RETRIES=2
INTERNS2_MAX_TOKENS=2048
# Deterministic structured extraction is the Step 7 default.
INTERNS2_TEMPERATURE=0
INTERNS2_TOP_P=0.95
INTERNS2_MAX_TOOL_ROUNDS=3

# Step 7 deterministic normalization defaults. Missing unit/frame may use these
# only in simulation mode; real mode returns a clarification instead.
RUNTIME_MODE=simulation
DEFAULT_COORDINATE_FRAME=robot_base
DEFAULT_DISTANCE_UNIT=mm
DEFAULT_RELATIVE_STEP_MM=5

# Step 8 deterministic orchestration safety limits. These values are enforced
# by normal Python code after model parsing; InternS2 cannot override them.
ENTRY_TOLERANCE_MM=1
MAX_TRANSLATION_PER_COMMAND_MM=20
ROBOT_MOVE_SPEED_MM_S=5
MAX_ROBOT_SPEED_MM_S=10

# Step 6 robot-simulation service. Keep Uvicorn at one process: one worker must
# exclusively own SOFA and the OpenGL context.
ROBOT_SIMULATION_BASE_URL=http://127.0.0.1:8001
ROBOT_SIMULATION_HOST=0.0.0.0
ROBOT_SIMULATION_PORT=8001
ROBOT_SIMULATION_LOG_LEVEL=info
# 1 pauses an active trajectory when all MJPEG/WebSocket clients disconnect.
# Keep 0 for headless CLI work; use 1 for the Step 12 browser demonstration.
SIMULATION_PAUSE_ON_NO_CLIENTS=0

# Step 9 planner-adapter. The external provider is intentionally unavailable
# until the senior team supplies its transport and schema specification.
PLANNER_ADAPTER_BASE_URL=http://127.0.0.1:8002
PLANNER_ADAPTER_HOST=0.0.0.0
PLANNER_ADAPTER_PORT=8002
PLANNER_ADAPTER_LOG_LEVEL=info
PLANNER_PROVIDER=mock
PLANNER_MOCK_OUTCOME=success
PLANNER_EXPECTED_OUTPUT_SCHEMA_VERSION=preview-v1
PLANNER_REQUEST_TIMEOUT=10

# Step 10 CLI service clients. Puncture execution is deliberately disabled;
# only robot positioning and non-executable path planning are implemented.
ROBOT_SIMULATION_HTTP_TIMEOUT=10
ROBOT_SIMULATION_COMMAND_TIMEOUT=120
ROBOT_SIMULATION_POLL_INTERVAL=0.05
PLANNER_ADAPTER_TIMEOUT=15
PUNCTURE_EXECUTION_ENABLED=false

# Step 11 FastAPI + React web console. Keep one Uvicorn worker because the
# in-memory session store and robot-global command arbiter are process-local.
AGENT_WEB_HOST=0.0.0.0
AGENT_WEB_PORT=8000
AGENT_WEB_LOG_LEVEL=info

# Step 13 local, non-streaming ASR. The model directory is mounted read-only
# into agent-web; local_files_only is enforced and runtime never downloads it.
ASR_BACKEND=faster-whisper
ASR_MODEL_PATH=/opt/asr-models/faster-whisper-small
ASR_MODEL_NAME=faster-whisper-small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
ASR_BEAM_SIZE=5
ASR_CPU_THREADS=4
ASR_MAX_AUDIO_BYTES=10485760
ASR_MIN_DURATION_SECONDS=0.25
ASR_MAX_DURATION_SECONDS=30
ASR_LOW_CONFIDENCE_THRESHOLD=0.65

# Step 14 browser-camera gesture recognition. Raw, unmirrored JPEG frames are
# classified by the already deployed InternS2 VLM; no MediaPipe model or fifth
# service is added. Ordinary directions need consecutive stable classifications
# and still require explicit confirmation before robot movement. STOP/ESTOP use
# the fast path after a single high-confidence classification.
GESTURE_MIN_CONFIDENCE=0.85
GESTURE_SAFETY_MIN_CONFIDENCE=0.80
GESTURE_STABLE_FRAMES=2
GESTURE_COOLDOWN_SECONDS=1.0
GESTURE_VOICE_CONFLICT_WINDOW_SECONDS=1.5
